# ==============================================================================
# Environment Configuration Template for Backend (Spring Boot)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with credentials to version control.
# ==============================================================================

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret (minimum 32 characters / 256 bits)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# AI Provider API Keys (Google accepts GOOGLE_AI_API_KEY or GEMINI_API_KEY;
# supports multiple comma-separated keys for automatic failover/rotation on rate limits)
GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

# GitHub OAuth Integration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel OAuth Integration (Production SaaS 1-click connect)
# Create at: https://vercel.com/dashboard/integrations/console
# Set Redirect URL to: http://localhost:3000/auth/vercel/callback (or your production domain)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# Integration slug from your Vercel Integration settings (e.g. blueprint-ai)
VERCEL_INTEGRATION_SLUG=
VERCEL_REDIRECT_URI=http://localhost:3000/auth/vercel/callback

# Encryption key for stored OAuth/Personal Access Tokens (AES-256-GCM; falls back to JWT_SECRET if blank)
TOKEN_ENCRYPTION_KEY=

# Test-only mock checkout (never charges money). Set true only for local testing.
# BILLING_DEMO_ENABLED=true

# Razorpay test credentials (never commit real credentials). Use test-mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false until test checkout has been validated and live compliance is complete.
RAZORPAY_LIVE_ENABLED=false
# Monthly Pro pass, in paise (49900 = Rs 499); each successful purchase lasts 30 days.
BILLING_PRO_PRICE_PAISE=49900
